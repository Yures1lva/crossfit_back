# ═══════════════════════════════════════════════════
# CrossFit Arena — Variáveis de Ambiente
# ═══════════════════════════════════════════════════
# Copie para .env e preencha os valores.
# Em PRODUÇÃO (Render), configurar direto no dashboard.

# ── Banco de Dados ────────────────────────────────
# DEV: PostgreSQL local
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=sua_senha
DB_NAME=crossfit_arena

# PROD (legado — Supabase, sendo migrado para Postgres self-hosted na Hostinger)
# DB_HOST=aws-1-sa-east-1.pooler.supabase.com
# DB_PORT=5432
# DB_USER=postgres.xxxxxxxxxxxxxxxx
# DB_PASSWORD=xxxxx
# DB_NAME=postgres

# PROD: Postgres containerizado na VPS Hostinger (ver mds/06-migracao-postgres-appwrite.md)
# DB_HOST=postgres
# DB_PORT=5432
# DB_USER=crossfit_app
# DB_PASSWORD=xxxxx
# DB_NAME=crossfit_arena

# ── JWT ───────────────────────────────────────────
JWT_ACCESS_SECRET=crossfit_access_secret_CHANGE_ME
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=crossfit_refresh_secret_CHANGE_ME
JWT_REFRESH_EXPIRES_IN=7d

# ── App ───────────────────────────────────────────
PORT=3004
NODE_ENV=development
DOMAIN=localhost

# ── Pool ──────────────────────────────────────────
DB_POOL_MIN=1
DB_POOL_MAX=10

# ── Storage ───────────────────────────────────────
# local = disco local (dev), supabase = Supabase Storage (legado), minio = MinIO self-hosted (prod)
STORAGE_DRIVER=local
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SERVICE_KEY=eyJhbG...

# MinIO (self-hosted na VPS Hostinger — ver mds/06-migracao-postgres-appwrite.md)
# MINIO_ENDPOINT=minio
# MINIO_PORT=9000
# MINIO_ROOT_USER=xxxxx
# MINIO_ROOT_PASSWORD=xxxxx
# MINIO_USE_SSL=false
# MINIO_PUBLIC_URL=https://minio.sooacosports.com.br  (opcional, se expuser publicamente atrás do nginx)

# ── CORS / Cookies ────────────────────────────────
FRONTEND_URL=http://localhost:3000
# Em produção: FRONTEND_URL=https://sooacosports.com.br
COOKIE_DOMAIN=
# Em produção: COOKIE_DOMAIN=.sooacosports.com.br
# (o ponto inicial abrange subdomínios: api.sooacosports.com.br, app.sooacosports.com.br)
